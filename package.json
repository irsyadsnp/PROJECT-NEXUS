{
  "name": "project-nexus",
  "version": "0.1.0",
  "private": true,
  "description": "A universe of games, built by everyone.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @nexus/web",
    "build": "npm run build --workspace @nexus/web",
    "start": "npm run start --workspace @nexus/web",
    "lint": "npm run lint --workspace @nexus/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "api:dev": "npm run dev --workspace @nexus/api",
    "api:build": "npm run build --workspace @nexus/api",
    "api:start": "npm run start --workspace @nexus/api",
    "api:typecheck": "npm run typecheck --workspace @nexus/api",
    "api:test": "npm run test --workspace @nexus/api"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  }
}
